  <diagram id="justificativas" name="Justificativas">
    <mxGraphModel page="1" pageWidth="827" pageHeight="1169">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="texto" value="&lt;h1&gt;Justificativas de cardinalidades e especializações&lt;/h1&gt;&lt;p&gt;&lt;b&gt;PESSOA&lt;/b&gt; é parcial e sobreposta: uma pessoa pode não ser paciente/profissional ou pertencer aos dois subtipos.&lt;/p&gt;&lt;p&gt;&lt;b&gt;ATUACAO_PROFISSIONAL&lt;/b&gt; é total e disjunta: cada período tem exatamente um papel. Um profissional pode mudar de papel, mas períodos não se sobrepõem.&lt;/p&gt;&lt;p&gt;Cada &lt;b&gt;ATENDIMENTO&lt;/b&gt; possui exatamente um paciente, residente, preceptor e unidade; cada uma dessas entidades pode participar de zero a muitos atendimentos.&lt;/p&gt;&lt;p&gt;&lt;b&gt;PROCEDIMENTO_REALIZADO&lt;/b&gt; materializa o N:N e registra quantidade, tempo real, início, observação e faturamento.&lt;/p&gt;&lt;p&gt;Cada &lt;b&gt;ESCALA&lt;/b&gt; possui uma unidade, residente e preceptor. A unicidade impede dois supervisores ou duas unidades para o residente na mesma data e turno.&lt;/p&gt;&lt;p&gt;&lt;b&gt;INTERNACAO&lt;/b&gt; preserva o histórico N:1 de paciente e unidade. &lt;b&gt;AUDITORIA_ATENDIMENTO&lt;/b&gt; usa referência lógica para sobreviver ao DELETE.&lt;/p&gt;&lt;p&gt;O dia da semana é derivado de data_plantao, evitando redundância e inconsistência.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="740" height="1000" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
